{
  "name": "tome2mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-friendly web port of ToME 2 (Tales of Middle-earth)",
  "type": "module",
  "scripts": {
    "engine:configure": "emcmake cmake -S . -B build -DCMAKE_BUILD_TYPE=Release",
    "engine:build": "cmake --build build --target tome --parallel",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
